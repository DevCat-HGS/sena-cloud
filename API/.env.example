# Copia este archivo como API/.env y completa los valores. Nunca subas el .env al repositorio.
MONGO_URI=mongodb://localhost:27017/senacloud
PORT=3001
NODE_ENV=development
# Cadena larga y aleatoria, por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Correo saliente (notificaciones). Con Gmail, usa una contraseña de aplicación.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
# Contraseña de los usuarios de prueba que crea scripts/injectUsers.js (12+ caracteres).
SEED_PASSWORD=
